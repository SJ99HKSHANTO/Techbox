rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == 'shantoray049@gmail.com');
    }

    // Public read for posts worldwide; all users and authors can publish posts!
    // Admin can update/delete any post; authors can update/delete their own posts
    match /posts/{postId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.author.uid == request.auth.uid);
    }

    // User profiles - any authenticated user can create/update their own profile
    // Admin and public can read user profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Visitor logs - visitors can create log entries; Admin can read all
    match /visitor_logs/{logId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }
  }
}
